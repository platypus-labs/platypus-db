{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PlatypusDB",
  "version": "0.5.0",
  "identifier": "dev.platypusdb.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "PlatypusDB",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 500,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --in-process-gpu"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; frame-src http://platypus-plugin.localhost platypus-plugin://localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "PlatypusDB",
    "shortDescription": "Fast, lightweight SQL client",
    "category": "DeveloperTool",
    "fileAssociations": [
      {
        "ext": ["platypus"],
        "name": "PlatypusDB shared query",
        "description": "A SQL query shared from PlatypusDB",
        "mimeType": "application/vnd.platypusdb.query+json",
        "role": "Editor"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["platypus"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZDMjVCQkU3QTg3RDZCRUQKUldUdGEzMm81N3NsL0k5RElGTU1icmREQmlnSG5oU0lNRUxWajZUdW5jTmk2Z0Q1UDhzMXJuVWQK",
      "endpoints": [
        "https://github.com/PaoloCisly/platypus-db/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
