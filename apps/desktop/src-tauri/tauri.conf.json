{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PlatypusDB",
  "version": "0.1.0",
  "identifier": "dev.platypusdb.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PlatypusDB",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 500,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --in-process-gpu"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "PlatypusDB",
    "shortDescription": "Fast, lightweight SQL client",
    "category": "DeveloperTool",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQxQkFCNUQwQUY4NEQzMkUKUldRdTA0U3YwTFc2MFZlK0lLenA3MnNYVCt3WFF5MjF4dUlmRWxGdTdUanZJZWFMSFBQSE1GZEsK",
      "endpoints": [
        "https://github.com/PaoloCisly/platypus-db/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
