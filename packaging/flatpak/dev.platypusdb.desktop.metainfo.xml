<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>dev.platypusdb.desktop</id>
  <name>PlatypusDB</name>
  <summary>Fast, lightweight SQL client</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>AGPL-3.0-or-later</project_license>
  <developer id="com.github.paolocisly">
    <name>PlatypusDB</name>
  </developer>
  <description>
    <p>
      A fast, lightweight desktop SQL client for PostgreSQL, MySQL, MariaDB, SQLite, SQL Server,
      DuckDB and more. It scrolls through millions of rows, edits data with a preview of the SQL,
      explains queries with a heatmap of the plan, and lets AI agents work on your databases
      through its MCP server, within the limits you set.
    </p>
  </description>
  <launchable type="desktop-id">dev.platypusdb.desktop.desktop</launchable>
  <url type="homepage">https://github.com/platypus-db/platypus-db</url>
  <url type="bugtracker">https://github.com/platypus-db/platypus-db/issues</url>
  <screenshots>
    <screenshot type="default">
      <image>https://raw.githubusercontent.com/platypus-db/platypus-db/main/docs/screenshots/data-viewer.png</image>
      <caption>Browsing a table</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/platypus-db/platypus-db/main/docs/screenshots/explain.png</image>
      <caption>A query plan with its heatmap</caption>
    </screenshot>
  </screenshots>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="@VERSION@" date="@DATE@">
      <url type="details">https://github.com/platypus-db/platypus-db/releases/tag/v@VERSION@</url>
    </release>
  </releases>
</component>
